# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Only needed for legacy HS256-signed projects; new projects (ES256/RS256 signing
# keys) are verified via the JWKS endpoint automatically — leave blank.
SUPABASE_JWT_SECRET=
# Direct Postgres connection string (Supabase → Settings → Database → Connection string,
# use the *session-mode* pooler URI). Used by dlt pipelines and API reads.
SUPABASE_DB_URL=

# --- Meta Marketing API ---
# System User token from the ZMS Business Manager (long-lived; scopes: ads_read, business_management).
# One token covers all client ad accounts shared to the BM.
META_SYSTEM_USER_TOKEN=

# --- Google Ads API (ZMS MCC) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- GoHighLevel ---
# Agency OAuth token, or a Private Integration token (prefix "pit-")
GHL_AGENCY_TOKEN=

# --- Redis / Celery (overridden by docker-compose for containers) ---
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

TZ=America/Los_Angeles

# --- Setter leaderboard (read-only Google Sheets mirror) ---
# Optional service account key (JSON string or file path) with spreadsheets.readonly +
# drive.readonly; share both sheets with its email. Falls back to GOOGLE_SHEETS_REFRESH_TOKEN.
GOOGLE_SERVICE_ACCOUNT_JSON=
# SETTER_COMMISSION_SHEET_ID=11ypFwukW3Gj84EJFnGcaMfpASGSkAAEcGk6k3MdFFFs
# SETTER_TRACKING_SHEET_ID=1lnV1r09ndultnRWrQVLYTOVfWN5RnQAcgNFp-xmsWcI
# SETTER_NAMES=["Brooklyn","Jonathan","Matthew","Morgan","Natashia"]
# SETTER_FORMER_NAMES=["Dylan"]
# SETTER_TEAM_GOAL=0                # $ Zeal revenue from setter-booked appts per month (0 = no goal yet)
# SETTER_DEFAULT_ZEAL_FEE=0         # $ Zeal earns per booked appt when a client has no fee in Settings
# SETTER_FLAT_RATE_FROM=2026-10-01  # from this appointment date every Show pays SETTER_FLAT_RATE
# SETTER_FLAT_RATE=3
# SETTER_SYNC_INTERVAL_SECONDS=60

# --- Hardening (2026-09) ---
# production | staging | development. Production disables /docs and /openapi.json.
ENVIRONMENT=production
# Public URL of this environment (Slack links, CORS, Origin check).
DASHBOARD_URL=https://adbuildout.contractorscalingblueprint.com
# Extra browser origins allowed for state-changing requests (JSON list), e.g. legacy alias hosts.
ALLOWED_ORIGINS=["https://ads.contractorscalingblueprint.com"]
# Set by scripts/deploy.sh; reported by /api/health.
GIT_SHA=
# Rate limits (slowapi). memory:// is per-process; use redis://redis:6379/3 if scaling out.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_MUTATION=30/minute
RATE_LIMIT_PLUGIN=120/minute
# /api/health marks a sync source stale after this many hours without a success.
HEALTH_SYNC_STALE_HOURS=26
LOG_LEVEL=INFO

# --- Campaign Builder (chat-driven campaign drafting, dashboard /build) ---
# Option A (default): Claude API key from console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
BUILDER_EFFORT=high
# Option B: any provider speaking the Anthropic Messages format, e.g. Meta Model API
# (dev.meta.ai; Muse Spark; $20 free credit on sign-up, US only). Leave blank for Claude.
# LLM_BASE_URL=https://api.meta.ai
# LLM_API_KEY=
# LLM_MODEL=muse-spark-1.3
# LLM_REASONING_EFFORT=medium      # optional: minimal|low|medium|high|xhigh
