# STAGING backend env — copy to backend/.env.staging (git-ignored) and fill in.
# Use the dedicated staging Supabase project and NEVER production Meta/Google/GHL tokens;
# leave the ad-platform tokens empty or use sandbox/test accounts.
#
# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Only needed for legacy HS256-signed projects; new projects (ES256/RS256 signing
# keys) are verified via the JWKS endpoint automatically — leave blank.
SUPABASE_JWT_SECRET=
# Direct Postgres connection string (Supabase → Settings → Database → Connection string,
# use the *session-mode* pooler URI). Used by dlt pipelines and API reads.
SUPABASE_DB_URL=

# --- Meta Marketing API ---
# System User token from the ZMS Business Manager (long-lived; scopes: ads_read, business_management).
# One token covers all client ad accounts shared to the BM.
META_SYSTEM_USER_TOKEN=

# --- Google Ads API (ZMS MCC) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- GoHighLevel ---
# Agency OAuth token, or a Private Integration token (prefix "pit-")
GHL_AGENCY_TOKEN=

# --- Redis / Celery (overridden by docker-compose for containers; staging redis is host port 6381) ---
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

TZ=America/Los_Angeles

# --- Setter leaderboard (read-only Google Sheets mirror) ---
# Optional service account key (JSON string or file path) with spreadsheets.readonly +
# drive.readonly; share both sheets with its email. Falls back to GOOGLE_SHEETS_REFRESH_TOKEN.
GOOGLE_SERVICE_ACCOUNT_JSON=
# SETTER_COMMISSION_SHEET_ID=11ypFwukW3Gj84EJFnGcaMfpASGSkAAEcGk6k3MdFFFs
# SETTER_TRACKING_SHEET_ID=1lnV1r09ndultnRWrQVLYTOVfWN5RnQAcgNFp-xmsWcI
# SETTER_NAMES=["Brooklyn","Jonathan","Matthew","Dylan"]
# SETTER_SYNC_INTERVAL_SECONDS=60

# --- Hardening (2026-09) ---
# production | staging | development. Production disables /docs and /openapi.json.
ENVIRONMENT=staging
# Public URL of this environment (Slack links, CORS, Origin check).
DASHBOARD_URL=https://staging-adbuildout.contractorscalingblueprint.com
# Extra browser origins allowed for state-changing requests (JSON list), e.g. legacy alias hosts.
ALLOWED_ORIGINS=[]
# Set by scripts/deploy.sh; reported by /api/health.
GIT_SHA=
# Rate limits (slowapi). memory:// is per-process; use redis://redis:6379/3 if scaling out.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_MUTATION=30/minute
RATE_LIMIT_PLUGIN=120/minute
# /api/health marks a sync source stale after this many hours without a success.
HEALTH_SYNC_STALE_HOURS=26
LOG_LEVEL=INFO
