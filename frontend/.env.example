# Supabase (public keys only — the browser talks to Supabase Auth directly)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend base URL (used by Next.js rewrites; docker-compose sets http://api:8000)
API_URL=http://localhost:8010

# Deployment metadata (names only; set by compose/CI)
# "staging" renders the amber STAGING banner in the nav; leave empty in production
NEXT_PUBLIC_ENVIRONMENT=
# Git SHA of the build, reported by GET /healthz (defaults to "dev")
NEXT_PUBLIC_GIT_SHA=
