# Copy to n8n/.env (gitignored) and fill in. Used by n8n/scripts to create and
# update workflows through the n8n public API. Never commit the real file.

# Base URL of your n8n instance, no trailing slash, e.g. https://n8n.example.com
N8N_URL=
# n8n → Settings → n8n API → Create an API key
N8N_API_KEY=
