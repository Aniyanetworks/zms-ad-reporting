      ],
      "name": "Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "UmpkC3NkKcg32kNA",
          "name": "ZMS Supabase Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce(json_agg(t order by t.name), '[]'::json) as data\nfrom (\n  select c.id, c.name, c.slug, c.meta_ad_account_id, c.google_ads_customer_id, c.google_lsa_customer_id, c.ghl_location_id,\n  c.avg_job_value, c.close_rate, c.gross_margin_pct, c.max_ad_cost_share, c.setter_fee_per_appt, c.default_service, c.trade, c.booking_system,\n  c.meta_campaign_filter, c.meta_pixel_id, c.cpl_target_green, c.cpl_target_red, c.is_active, c.created_at, (s.ghl_token is not null) as has_ghl_token\n  from clients c left join client_secrets s on s.client_id = c.id\n) t",
        "options": {}
      }
    },
    {
      "id": "2985b5b2-e5f6-42a1-a7af-df984202f9f7",
      "position": [
        1980,
        200
      ],
      "name": "DB error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const out = (() => {\nconst req = $('Webhook').first().json;\nconst user = $('Build user').first().json.user;\nconst err = $json.error;\nreturn { status: 500, body: { detail: 'Internal Server Error' } };\n})();\nreturn [{ json: out }];"
      }
    },
    {
      "id": "32eef517-959c-49d4-a8b4-768bd67d1941",
      "position": [
        2200,
        0
      ],
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const out = (() => {\nconst req = $('Webhook').first().json;\nconst user = $('Build user').first().json.user;\nconst data = $json.data;\nreturn { body: data };\n})();\nreturn [{ json: out }];"
      }
    },
