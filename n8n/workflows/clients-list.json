        "options": {}
      }
    },
    {
      "id": "6a43b1ea-9976-4527-af17-d5a3f922787e",
      "position": [
        880,
        200
      ],
      "name": "Token error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const e = $json.error;\nconst msg = (e && (e.message || e.description)) || (typeof e === 'string' ? e : 'invalid token');\nreturn [{ json: { error: { status: 401, detail: `Invalid token: ${msg}` } } }];"
      }
    },
    {
      "id": "1b97b27a-a5f2-478b-af76-16a9d0572cca",
      "position": [
        1100,
        0
      ],
      "name": "Load profile",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "id": "UmpkC3NkKcg32kNA",
          "name": "ZMS Supabase Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce((select to_jsonb(p) from (select role, full_name from profiles where id = $1::uuid) p), '{}'::jsonb) as profile",
        "options": {
          "queryReplacement": "={{ [$json.sub] }}"
        }
      }
    },
    {
      "id": "ac81dd6a-2770-41b6-a908-2c20e400ef3a",
      "position": [
        1320,
        0
      ],
      "name": "Build user",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const claims = $('Verify JWT').first().json;\nconst aud = Array.isArray(claims.aud) ? claims.aud : [claims.aud];\nif (!aud.includes('authenticated')) return [{ json: { error: { status: 401, detail: 'Invalid token: Invalid audience' } } }];\nconst p = $json.profile || {};\nconst role = [\"admin\",\"media_buyer\",\"viewer\"].includes(p.role) ? p.role : 'viewer';\nconst user = { id: claims.sub, email: claims.email ?? null, role, full_name: p.full_name ?? null };\nreturn [{ json: { user } }];"
      }
    },
