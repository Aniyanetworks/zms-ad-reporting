        "query": "select coalesce(json_object_agg(source, last_success), '{}'::json) as data\nfrom (\n  select source, max(finished_at) as last_success\n  from sync_runs where status = 'success' and source in ('meta', 'google', 'ghl')\n  group by source\n) t",
