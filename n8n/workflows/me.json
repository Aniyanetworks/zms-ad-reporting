      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce((select to_jsonb(p) from (select role, full_name from profiles where id = $1::uuid) p), '{}'::jsonb) as profile",
        "options": {
          "queryReplacement": "={{ [$json.sub] }}"
