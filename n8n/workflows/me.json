      ],
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const out = (() => {\nconst req = $('Webhook').first().json;\nconst user = $('Build user').first().json.user;\nconst data = null;\n\nconst r = user.role;\nconst isAdmin = r === 'admin';\nconst approver = r === 'admin' || r === 'media_buyer';\nreturn { body: {\n  id: user.id, email: user.email, role: r, full_name: user.full_name,\n  permissions: {\n    manage_clients: isAdmin,\n    trigger_sync: isAdmin,\n    dismiss: approver,\n    approve: approver,\n    approve_large_budget: isAdmin,\n    view_audit_log: isAdmin,\n    create_build: approver,\n    approve_build_max_daily_cents: isAdmin ? null : r === 'media_buyer' ? 50000 : 0,\n  },\n  budget_owner_threshold_pct: 20.0,\n  human_control_rules: [\"AI can prepare and modify drafts.\",\"AI can provide recommendations.\",\"AI cannot approve itself.\",\"Campaign creation requires human approval.\",\"Created campaigns must initially be paused.\",\"Campaign launch requires a separate human confirmation.\",\"Budget increases above 20% require the Agency Owner.\",\"Every consequential action is recorded in the audit log.\"],\n} };\n})();\nreturn [{ json: out }];"
      }
