# Root env consumed by docker compose (interpolation + web build args). Names only —
# never commit values. Backend secrets live in backend/.env (see backend/.env.example);
# staging uses .env.staging (root) + backend/.env.staging.

# --- Web build args (public Supabase project keys; baked into the Next.js bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Deployment metadata (set automatically by scripts/deploy.sh; leave empty for `docker compose up`) ---
# Image tag for zms-ads-api / zms-ads-web (deploy.sh uses the git sha; default "latest")
IMAGE_TAG=
# Git sha baked into the web build and reported by GET /healthz (deploy.sh sets it)
GIT_SHA=
# "production" | "staging" — the overlays set this; staging renders the amber banner
NEXT_PUBLIC_ENVIRONMENT=
# Alias of GIT_SHA for the frontend (docker-compose.yml maps GIT_SHA -> NEXT_PUBLIC_GIT_SHA)
NEXT_PUBLIC_GIT_SHA=

# Hostname that serves only the public /leaderboard page (setter leaderboard)
LEADERBOARD_HOST=setter.contractorscalingblueprint.com

# --- Backups (normally kept in ~/.config/zms/backup.env, mode 600, not here) ---
# age public key (age1...) the DB dumps and config bundles are encrypted to.
# Keep the matching private key OUTSIDE the Mac mini (password manager) and as AGE_IDENTITY
# (file path) only where verify-backup.sh runs.
AGE_RECIPIENT=
# Local backup root; dumps go to $BACKUP_DIR/db, bundles to $BACKUP_DIR/config (default ~/Backups/zms-ads)
BACKUP_DIR=
# Optional rclone remote for off-site copies, e.g. b2:zms-ads-backups (needs ~/.config/rclone/rclone.conf)
BACKUP_REMOTE=
